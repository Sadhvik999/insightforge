# ==============================================================================
# InsightForge Environment Configuration Template
# ==============================================================================
# DO NOT store real API keys or secrets in this template or commit them to version control.
# Copy this file to '.env' for local custom configuration.
# Every user can bring their own API key (BYOK) securely via the web Settings UI.
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=127.0.0.1

# Production CORS & Security (Comma-separated list of allowed origins)
# For local dev: http://localhost:5173,http://localhost:3000
# For production HTTPS: https://analytics.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# AI Provider Defaults & Security Policies
# ==============================================================================
DEFAULT_AI_PROVIDER=ollama

# Local Inference / Loopback Policy (ALLOW_LOCAL_CUSTOM_API)
# Default is FALSE for production safety. In production deployments, loopback destinations
# (localhost, 127.0.0.1, ::1) are strictly rejected to prevent SSRF against host services.
# For local developer testing with local Ollama, vLLM, or LM Studio, set:
# ALLOW_LOCAL_CUSTOM_API=true
ALLOW_LOCAL_CUSTOM_API=false

# Local Ollama Inference (Default free, local server inference)
# Requires ALLOW_LOCAL_CUSTOM_API=true when running locally against loopback.
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=qwen2.5:1.5b

# Cloud AI Provider Defaults (Optional template variables)
# Developer keys must NEVER be committed. Users configure their own keys in Settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Production Architecture & Multi-Worker Notes
# ==============================================================================
# 1. Credential Security: User-provided API keys are held strictly in temporary
#    server process memory (never persisted to disk, database, or browser storage).
# 2. Multi-Worker Deployments: When running Uvicorn/Gunicorn with multiple workers
#    behind a reverse proxy (Nginx, Traefik, HAProxy, AWS ALB), configure session
#    affinity (sticky sessions via cookie or ip_hash) to guarantee that follow-up
#    requests from a user route to the worker holding their in-memory session.
# 3. Transport Security: Production deployments must enforce HTTPS/TLS at the reverse
#    proxy to safeguard credentials in transit across all endpoints.
